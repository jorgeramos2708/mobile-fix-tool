<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Fuentes de paquetes fijadas para que la compilación sea reproducible en cualquier máquina.

    Requisito detectado en v0.1.0: el entorno no trae nuget.org configurado por defecto y, sin esta
    fuente, el publish autocontenido falla con NU1100 (no se pueden resolver los runtime packs
    Microsoft.NETCore.App.Runtime.win-x64 y Microsoft.WindowsDesktop.App.Runtime.win-x64).

    El feed privado de DevExpress (ADR-002) se añadirá aquí cuando se adquiera la licencia.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
