    <Content Include="../../docs/inventario-demo.csv" Link="inventario-demo.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MobileFix.Domain\MobileFix.Domain.csproj" />
    <ProjectReference Include="..\..\src\MobileFix.Ports\MobileFix.Ports.csproj" />
    <ProjectReference Include="..\..\src\MobileFix.UseCases\MobileFix.UseCases.csproj" />
    <ProjectReference Include="..\..\src\MobileFix.Infrastructure\MobileFix.Infrastructure.csproj" />
  </ItemGroup>

</Project>