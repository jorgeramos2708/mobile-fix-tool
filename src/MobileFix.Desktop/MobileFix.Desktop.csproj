<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aplicación de escritorio. ADR-001: WPF sobre .NET 10 LTS.
    ADR-002/003: DevExpress será la única suite de controles y el único motor de tema;
    todavía no está referenciada porque requiere licencia. El tema actual usa colores
    literales de docs/DESIGN-TOKENS.md como marcador de posición temporal.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MobileFix.Desktop</RootNamespace>
    <AssemblyName>MobileFix</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
  </PropertyGroup>

  <!-- El inventario de ejemplo viaja con la aplicación para que la pestaña de cobertura
       tenga datos al abrir el ejecutable público. -->
  <ItemGroup>
    <Content Include="../../docs/inventario-demo.csv" Link="inventario-demo.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MobileFix.Domain/MobileFix.Domain.csproj" />
    <ProjectReference Include="../MobileFix.Ports/MobileFix.Ports.csproj" />
    <ProjectReference Include="../MobileFix.UseCases/MobileFix.UseCases.csproj" />
    <ProjectReference Include="../MobileFix.Infrastructure/MobileFix.Infrastructure.csproj" />
  </ItemGroup>

</Project>
