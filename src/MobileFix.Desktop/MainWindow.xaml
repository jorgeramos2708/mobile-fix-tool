<Window x:Class="MobileFix.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobileFix Tool — Sesión de reparación"
        Height="760" Width="1220"
        Background="#0C0F15"
        Foreground="#E8EAED">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="SESIÓN DE REPARACIÓN" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="#1F2430" CornerRadius="4" Padding="10,3" Margin="16,0,0,0">
                <TextBlock Text="v0.1.0 · esqueleto · sin hardware" Foreground="#9AA3B2" FontSize="12" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pipeline de 13 etapas -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Stages}"
                     Background="#141821"
                     BorderBrush="#2A3140"
                     BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="12" Height="12"
                                     Fill="{Binding StatusBrush}"
                                     VerticalAlignment="Top" Margin="0,4,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Foreground="#E8EAED" FontSize="13" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Kind}" Foreground="#6B7280" FontSize="11" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Detail}" Foreground="#9AA3B2" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Consola y acciones -->
            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Ejecutar sesión simulada"
                            Command="{Binding RunSessionCommand}"
                            Padding="14,8" Margin="0,0,8,0" />
                    <Button Content="Demostrar Safety Gate bloqueado"
                            Command="{Binding RunBlockedCommand}"
                            Padding="14,8" Margin="0,0,8,0" />
                    <Button Content="Verificar cadena del journal"
                            Command="{Binding VerifyCommand}"
                            Padding="14,8" />
                </StackPanel>

                <TextBox Text="{Binding Log, Mode=OneWay}"
                         IsReadOnly="True"
                         Background="#0C0F15"
                         Foreground="#C9D1D9"
                         FontFamily="Cascadia Mono, Consolas, Courier New"
                         FontSize="12"
                         Padding="10"
                         BorderBrush="#2A3140"
                         BorderThickness="1"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>

        <!-- Barra de estado: la salud del enlace es el dato ambiental más importante -->
        <Border Grid.Row="2" Background="#141821" CornerRadius="4" Padding="12,7" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LinkStatus}" Foreground="#D97706" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding JournalStatus}" Foreground="#9AA3B2" FontSize="12" Margin="28,0,0,0" />
                <TextBlock Text="Toda operación de escritura queda registrada de forma encadenada."
                           Foreground="#6B7280" FontSize="12" Margin="28,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
