<Window x:Class="MobileFix.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobileFix Tool — Sesión de reparación"
        Height="800" Width="1280"
        Background="#0C0F15"
        Foreground="#E8EAED">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="MOBILEFIX" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Background="#1F2430" CornerRadius="4" Padding="10,3" Margin="16,0,0,0">
                <TextBlock Text="v0.1.0 · esqueleto · sin hardware" Foreground="#9AA3B2" FontSize="12" />
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,14,0,0" Background="#141821" BorderBrush="#2A3140">

            <!-- ============================ SESIÓN ============================ -->
            <TabItem Header="Sesión">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Stages}"
                             Background="#141821"
                             BorderBrush="#2A3140"
                             BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="12" Height="12"
                                             Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="#E8EAED" FontSize="13" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Kind}" Foreground="#6B7280" FontSize="11" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Foreground="#9AA3B2" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Ejecutar sesión simulada" Command="{Binding RunSessionCommand}" Padding="14,8" Margin="0,0,8,0" />
                            <Button Content="Demostrar Safety Gate bloqueado" Command="{Binding RunBlockedCommand}" Padding="14,8" Margin="0,0,8,0" />
                            <Button Content="Verificar cadena del journal" Command="{Binding VerifyCommand}" Padding="14,8" />
                        </StackPanel>

                        <TextBox Text="{Binding Log, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="#0C0F15"
                                 Foreground="#C9D1D9"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="12"
                                 Padding="10"
                                 BorderBrush="#2A3140"
                                 BorderThickness="1"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ======================= COBERTURA DEL BANCO ======================= -->
            <TabItem Header="Cobertura del banco">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Aviso de cobertura provisional: debe ser imposible de ignorar -->
                    <Border Grid.Row="0" Background="#3A1D1D" BorderBrush="#DC2626" BorderThickness="1"
                            CornerRadius="4" Padding="12,8" Margin="0,0,0,10"
                            Visibility="{Binding ProvisionalVisibility}">
                        <TextBlock Text="{Binding CoverageBanner}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Abrir inventario…" Command="{Binding LoadInventoryCommand}" Padding="14,8" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CoverageSummary}" Foreground="#E8EAED" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CoverageSource}" Foreground="#6B7280" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock DockPanel.Dock="Top" Text="Equipos por mecanismo de acceso"
                                       Foreground="#9AA3B2" FontSize="12" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding MechanismRows}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="#0C0F15"
                                      Foreground="#C9D1D9"
                                      BorderBrush="#2A3140"
                                      RowBackground="#0C0F15"
                                      AlternatingRowBackground="#141821"
                                      HorizontalGridLinesBrush="#2A3140"
                                      ColumnHeaderHeight="26" />
                        </DockPanel>

                        <DockPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock DockPanel.Dock="Top" Text="Cobertura por nivel de intervención"
                                       Foreground="#9AA3B2" FontSize="12" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding InterventionRows}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Background="#0C0F15"
                                      Foreground="#C9D1D9"
                                      BorderBrush="#2A3140"
                                      RowBackground="#0C0F15"
                                      AlternatingRowBackground="#141821"
                                      HorizontalGridLinesBrush="#2A3140"
                                      ColumnHeaderHeight="26" />
                        </DockPanel>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="¿Qué puede hacer la plataforma con este equipo? (resolución de ejemplo)"
                                   Foreground="#9AA3B2" FontSize="12" Margin="0,0,0,6" />
                        <DataGrid ItemsSource="{Binding VerdictRows}"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  MaxHeight="200"
                                  Background="#0C0F15"
                                  Foreground="#C9D1D9"
                                  BorderBrush="#2A3140"
                                  RowBackground="#0C0F15"
                                  AlternatingRowBackground="#141821"
                                  HorizontalGridLinesBrush="#2A3140"
                                  ColumnHeaderHeight="26" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Barra de estado: la salud del enlace es el dato ambiental más importante -->
        <Border Grid.Row="2" Background="#141821" CornerRadius="4" Padding="12,7" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LinkStatus}" Foreground="#D97706" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding JournalStatus}" Foreground="#9AA3B2" FontSize="12" Margin="28,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
